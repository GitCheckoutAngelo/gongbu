# Frontend config. These values are public (bundled into the browser) -- never put API keys here.
# Worker secrets go in .dev.vars instead (see .dev.vars.example).

# Default voice: "google_cloud" (default) or "browser". Users can change it with the voice chip (top right).
VITE_DEFAULT_TTS_PROVIDER=google_cloud

# Where the API lives. "/api" is the Worker on the same origin (dev, preview and production).
VITE_API_BASE_URL=/api

# Common Words: spaced-repetition scheduler ("sm2") and where progress is kept ("local" = this browser).
VITE_SRS_SCHEDULER=sm2
VITE_PROGRESS_STORE=local
